@using DemoMVC.Models.DTO
@model EmployeesDTO
<div class="container">
    <h2 class="text-center">My Profile</h2>
    <div class="row">

        <div class="col-6 offset-3">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="EmpId" />
                <input asp-for="AppUserId" class="form-control" readonly type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-1">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-1">
                    <label asp-for="Email" class="control-label"></label>
                    <input asp-for="Email" class="form-control" readonly />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-1">
                    <label asp-for="DateOfBirth" class="control-label"></label>
                    <input asp-for="DateOfBirth" class="form-control" type="date" data-date="" data-date-format="DD MM YYYY" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>
                <div class="mb-1">
                    <label asp-for="PhoneNumber" class="control-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    <div class="mb-1">
                        <label asp-for="Address" class="control-label"></label>
                        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <input type="submit" class="btn btn-outline-primary btn-block" value="Save" />
                    <a asp-action="Index" asp-controller="Home" class="btn btn-outline-warning btn-block">Cancel</a>
            </form>
        </div>
    </div>
</div>